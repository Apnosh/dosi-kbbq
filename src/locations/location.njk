---
layout: base.njk
pagination:
  data: locations
  size: 1
  alias: loc
permalink: "{{ loc.page }}"
eleventyComputed:
  title: "{{ 'Korean BBQ in West Seattle, Alki Beach' if loc.key == 'alki' else 'Korean BBQ in Kent, WA: Menu and Hours' }}"
  description: "{{ 'All-you-can-eat Korean BBQ steps from the Alki Beach waterfront in West Seattle. ' if loc.key == 'alki' else 'The first Korean BBQ in Kent, WA, serving Kent, Renton, Auburn and South King County. ' }}Hours, menu, directions and reservations for Do Si Korean BBQ {{ loc.name }}."
  schemaRestaurants: "{{ loc.key }}"
---
{%- set l = loc | withPortal(apnosh) -%}
{%- set A = menus.ayce[loc.key] -%}
{%- set special = l.specialHours | upcomingSpecial if l.specialHours else [] -%}
<section class="hero hero--page">
  <div class="hero__media" aria-hidden="true">
    {% if loc.key == 'alki' %}{% img "alki-storefront", "", { sizes: "100vw", eager: true } %}{% else %}{% img "kent-storefront", "", { sizes: "100vw", eager: true, h: 1200 } %}{% endif %}
  </div>
  <div class="wrap hero__inner">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/locations/">Locations</a><span aria-hidden="true">/</span><span>{{ loc.name }}</span></nav>
    <p class="eyebrow">{{ loc.neighborhood }}</p>
    <h1 class="display h1">{{ loc.headline }}</h1>
    <div class="btn-row" style="margin-top:28px">
      <a class="btn btn--red" href="{{ loc.reserveUrl }}" data-apnosh="book" target="_blank" rel="noopener">Reserve a table</a>
      <a class="btn btn--ghost" href="{{ loc.menuPage }}">{{ loc.name }} menu</a>
      <a class="btn btn--ghost" href="{{ l.phone | telHref }}">Call {{ l.phone }}</a>
    </div>
  </div>
</section>

<section class="section section--tight">
  <div class="wrap loc-page">
    <div>
      <p class="lede" style="margin-bottom:28px">{{ loc.blurb }}</p>
      <div class="price-tiles">
        <a href="{{ loc.menuPage }}#ayce"><small>Signature</small><b>{{ A.signature }}</b><span>24 meats</span></a>
        <a href="{{ loc.menuPage }}#ayce"><small>Premium</small><b>{{ A.premium }}</b><span>28 meats</span></a>
        <a href="{{ loc.menuPage }}#ayce" class="is-hot"><small>Supreme</small><b>{{ A.supreme }}</b><span>32 meats + 5 apps</span></a>
      </div>
      <div class="photo-strip">
        {% if loc.key == 'alki' %}
        <div>{% img "dining-room", "The dining room at Do Si Korean BBQ Alki Beach", { sizes: "33vw" } %}</div>
        <div>{% img "alki-deck-wide", "The rooftop deck at Alki Beach, with umbrellas over the water", { sizes: "33vw" } %}</div>
        <div>{% img "dining-windows", "Upstairs at Alki, with windows onto the beach", { sizes: "33vw" } %}</div>
        {% else %}
        <div>{% img "kent-storefront", "Do Si Korean BBQ on Kent-Kangley Road", { sizes: "33vw", h: 1200 } %}</div>
        <div>{% img "grill-spread", "Meats on the tabletop grill at Do Si Korean BBQ Kent", { sizes: "33vw" } %}</div>
        <div>{% img "kbbq-spread-2", "A full table of Korean BBQ, stews and sides", { sizes: "33vw" } %}</div>
        {% endif %}
      </div>
      <div class="rules">
        {% for x in loc.extras %}<span>{{ x }}</span>{% endfor %}<span>90-minute AYCE</span><span>Kids 4–10 half price</span>
      </div>
      {% if loc.key == 'alki' %}
      <div class="quotes quotes--compact" style="margin-top:28px">
        {% for q in reviews.home | batch(3) | first %}<figure class="quote"><span class="stars" aria-label="5 stars">★★★★★</span><blockquote>“{{ q.quote }}”</blockquote><figcaption>{{ q.name }} · Google</figcaption></figure>{% endfor %}
      </div>
      <p class="fine"><span class="stars">★</span> {{ reviews.summary.rating }} average from {{ reviews.summary.count }} recent Google reviews</p>
      {% endif %}
      {% if loc.key == 'alki' %}<a class="callout" href="/private-events/"><span><b>Private events &amp; buyouts</b>Rent Do Si Alki for your group</span><span class="callout__go">Request a date →</span></a>{% endif %}
      <p class="muted" style="margin-top:28px;font-size:.92rem">Serving {{ loc.areaServed | join(", ") }}.</p>
    </div>
    <aside class="info-card" aria-label="{{ loc.name }} details">
      <div>
        <h2>Address</h2>
        <a class="big" href="{{ l.address | mapsUrl }}" target="_blank" rel="noopener">{{ l.address.street }}<br>{{ l.address.city }}, {{ l.address.state }} {{ l.address.zip }}</a>
      </div>
      <div>
        <h2>Phone</h2>
        <a class="big" href="{{ l.phone | telHref }}">{{ l.phone }}</a>
      </div>
      <div>
        <h2>Hours</h2>
        <ul class="hours" data-hours='{{ l.hours | json }}'>{% for r in l.hours | hoursRows %}<li><span>{{ r.days }}</span><span>{{ r.time }}</span></li>{% endfor %}</ul>
        {% for s in special %}<p class="hours-special"><b>{{ s.date }}</b>: {{ s.time }}{% if s.reason %} · {{ s.reason }}{% endif %}</p>{% endfor %}
      </div>
      <div class="btn-row">
        <a class="btn btn--red" href="{{ loc.reserveUrl }}" data-apnosh="book" target="_blank" rel="noopener">Reserve</a>
        <a class="btn btn--ghost" href="{{ l.address | mapsUrl }}" target="_blank" rel="noopener">Directions</a>
      </div>
    </aside>
  </div>
  <div class="wrap" style="margin-top:clamp(40px,6vw,72px)">
    <div class="map"><iframe title="Map to Do Si Korean BBQ {{ loc.name }}" src="{{ l.address | mapsEmbed }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
  </div>
</section>
