      <details{% if loop.first %} open{% endif %}><summary>{{ f.q }}</summary><div class="answer"><p>{{ f.a | safe }}</p></div></details>
      {% endfor %}
    </div>
    <p class="muted" style="margin-top:32px">Still have a question? <a href="/contact/">Send us a message</a> or call Alki at <a href="tel:+12068068422">(206) 806-8422</a> or Kent at <a href="tel:+12539814277">(253) 981-4277</a>.</p>
