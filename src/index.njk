---
layout: base.njk
permalink: /
bodyClass: page-home
schemaRestaurants: all
description: All-you-can-eat Korean BBQ in Seattle from $27.95, in three tiers up to 32 meats, grilled at your table with banchan, stews, soju and cocktails. Or order à la carte. On Alki Beach in West Seattle and in Kent, WA.
---
{%- set alki = locations | byKey('alki') | withPortal(apnosh) -%}
{%- set kent = locations | byKey('kent') | withPortal(apnosh) -%}
{%- set A = menus.ayce -%}
{%- set R = reviews -%}
{%- set HH = menus.happyHour -%}

{# ================= HERO ================= #}
<section class="hero">
  <div class="hero__media" aria-hidden="true">
    <img src="/assets/img/hero-video-1600.jpg" srcset="/assets/img/hero-video-800.jpg 800w, /assets/img/hero-video-1600.jpg 1600w" sizes="100vw" alt="" width="1600" height="900" fetchpriority="high">
    <video class="hero__video" autoplay muted loop playsinline preload="auto" poster="/assets/img/hero-video-800.jpg" src="/assets/video/hero.mp4"></video>
  </div>
  <div class="wrap hero__inner">
    <p class="kr-label kr-label--left" lang="ko">도시 코리안 바베큐</p>
    <h1 class="hero__title">{{ apnosh.content['hero.headline'] or "All You Can Eat" }}<span class="accent">{{ apnosh.content['hero.lede'] or "Korean BBQ" }}</span></h1>
    <p class="hero__sub">On Alki Beach in West Seattle and in Kent. All you can eat from {{ A.kent.signature }}, or order à la carte.</p>
    <div class="btn-row">
      <a class="btn btn--red" href="/locations/#reserve" data-reserve>Reserve a table</a>
      <a class="btn btn--ghost" href="/menu/">See the menus</a>
    </div>
    <div class="hero__meta">
      <a class="rating" href="#reviews"><b>{{ R.summary.rating }}</b><span class="stars" aria-hidden="true">★</span>Google · {{ R.summary.count }} reviews</a>
      {% for l in [alki, kent] %}
      <a class="status-line" href="{{ l.page }}" data-hours='{{ l.hours | json }}'><span class="dot"></span><strong>{{ l.name }}</strong><span data-status>{{ l.address.street }}</span></a>
      {% endfor %}
    </div>
  </div>
</section>

{% if apnosh.activePromo %}
<aside class="promo" aria-label="Current offer">
  <div class="wrap promo__inner">
    <span class="promo__tag">Now on</span>
    <p><b>{{ apnosh.activePromo.name }}</b>{% if apnosh.activePromo.description %}. {{ apnosh.activePromo.description }}{% endif %}{% if apnosh.activePromo.valid_until %} <span class="muted">Ends {{ apnosh.activePromo.valid_until | niceDate }}.</span>{% endif %}</p>
    {% if apnosh.activePromo.code %}<span class="promo__code">Code {{ apnosh.activePromo.code }}</span>{% endif %}
  </div>
</aside>
{% endif %}

{# ================= AYCE BOARD ================= #}
<section class="section textured" id="ayce">
  <div class="wrap">
    <p class="kr-label" lang="ko">무한리필</p>
    <h2 class="rule-head"><span class="accent">All You</span> Can Eat</h2>
    <p class="sub">Per person. The whole table orders from the same menu.</p>
    <div class="board">
      <a class="board__col" href="/alki-menu/#ayce-signature">
        <div class="board__img">{% img "kbbq-spread", "A Korean BBQ table with pork belly, corn cheese and banchan", { sizes: "(max-width: 900px) 100vw, 33vw" } %}<span class="photo-label">24 meats</span></div>
        <h3><span class="accent">Signature</span> AYCE</h3>
        <p class="board__note">Brisket, pork belly, bulgogi, chicken and shrimp, with 13 appetizers and stews and endless banchan</p>
        <dl class="board__prices"><div><dt>Alki Beach</dt><dd>{{ A.alki.signature }}</dd></div><div><dt>Kent</dt><dd>{{ A.kent.signature }}</dd></div></dl>
      </a>
      <a class="board__col" href="/alki-menu/#ayce-premium">
        <div class="board__img">{% img "kbbq-cuts", "Ribeye, short rib and brisket ready for the grill", { sizes: "(max-width: 900px) 100vw, 33vw" } %}<span class="photo-label">28 meats</span></div>
        <h3><span class="accent">Premium</span> AYCE</h3>
        <p class="board__note">All of Signature, plus LA galbi, beef tongue, baby octopus and spicy squid</p>
        <dl class="board__prices"><div><dt>Alki Beach</dt><dd>{{ A.alki.premium }}</dd></div><div><dt>Kent</dt><dd>{{ A.kent.premium }}</dd></div></dl>
      </a>
      <a class="board__col board__col--top" href="/alki-menu/#ayce-supreme">
        <div class="board__img">{% img "kbbq-platter", "A platter of premium cuts over the grill", { sizes: "(max-width: 900px) 100vw, 33vw" } %}<span class="photo-label">32 meats</span><span class="tag tag--new board__new">5 new apps</span></div>
        <h3><span class="accent">Supreme</span> AYCE</h3>
        <p class="board__note">All of Premium, plus Angus ribeye and short rib, pork jowl, beef intestine, and Supreme-only apps like egg soufflé and bulgogi quesadilla</p>
        <dl class="board__prices"><div><dt>Alki Beach</dt><dd>{{ A.alki.supreme }}</dd></div><div><dt>Kent</dt><dd>{{ A.kent.supreme }}</dd></div></dl>
      </a>
    </div>
    <p class="fineline">Limit 90 minutes · Minimum 2 persons per table · Kids (4–10) half price · 4 meats &amp; 2 appetizers per round</p>
  </div>
</section>

{# ================= APPS & ENTREES, right under the AYCE tiers ================= #}
<section class="section section--tight" id="apps">
  <div class="wrap">
    <p class="kr-label" lang="ko">사이드 &amp; 식사</p>
    <h2 class="rule-head"><span class="accent">Apps</span> &amp; Entrées</h2>
    <p class="sub">On their own, or added to all you can eat.</p>
    <div class="plates">
      {% set plates = [
        { img: "yangnyeom-chicken", kr: "양념치킨", name: "Yangnyeom Chicken", spicy: true, alt: "Yangnyeom chicken wings in sweet chili glaze" },
        { img: "savory-egg-souffle", kr: "계란찜", name: "Egg Soufflé", best: true, alt: "Egg soufflé in a hot stone pot" },
        { img: "hot-stone-bibimbap", kr: "돌판비빔밥", name: "Hot Stone Bibimbap", best: true, alt: "Hot stone bibimbap with a fried egg" },
        { img: "tokbokki", kr: "떡볶이", name: "Tokbokki", spicy: true, alt: "Tokbokki rice cakes with cheese and egg" },
        { img: "kimchi-fried-rice", kr: "김치볶음밥", name: "Kimchi Fried Rice", spicy: true, alt: "Kimchi fried rice with a fried egg" }
      ] %}
      {% for d in plates %}
      <figure class="plate">
        <div class="plate__img plate__img--cut"><img src="/assets/img/menu/{{ d.img }}.webp" alt="{{ d.alt }}" width="320" height="320" loading="lazy" decoding="async">{% if d.best %}<span class="seal seal--sm">Best<br>seller</span>{% endif %}</div>
        <figcaption><span class="kr" lang="ko">{{ d.kr }}</span><span class="plate__name">{{ d.name }}{% if d.spicy %} <span class="chili" title="Spicy">🌶</span>{% endif %}</span></figcaption>
      </figure>
      {% endfor %}
    </div>
    <p class="center"><a class="arrow-link" href="/alki-menu/#apps-entrees">Full menu</a></p>
  </div>
</section>

<section class="section section--alt">
  <div class="wrap best">
    <div class="best__list">
      <p class="kr-label kr-label--left" lang="ko">인기 고기</p>
      <h2 class="display h2"><span class="accent">Best Sellers</span> on the Grill</h2>
      <ol class="mlist">
        {% for b in menus.grillBest %}
        <li class="mlist__item">
          <span class="mlist__num">{{ b.number }}</span>
          <span class="mlist__main"><span class="mlist__kr" lang="ko">{{ b.korean }}</span><span class="mlist__name">{{ b.name }}{% if b.spicy %} <span class="chili" title="Spicy">🌶</span>{% endif %}</span></span>
          <span class="mlist__tier{% if b.tier == 'Supreme' %} is-supreme{% endif %}">{{ b.tier }}</span>
        </li>
        {% endfor %}
      </ol>
      <a class="arrow-link" href="/alki-menu/#ayce">All 32 meats</a>
    </div>
    <div class="best__photos">
      <div class="best__a">{% img "kbbq-raw", "Thinly sliced brisket, pork belly and marinated meats with banchan", { sizes: "(max-width: 900px) 100vw, 40vw" } %}<span class="seal">Best<br>seller</span></div>
      <div class="best__b">{% img "grill-galbi", "Grilled galbi with chopsticks", { sizes: "(max-width: 900px) 60vw, 25vw" } %}</div>
    </div>
  </div>
</section>

{# ================= FIRST TIME ================= #}
<section class="section first">
  <div class="wrap first__inner">
    <picture class="first__lion"><source type="image/webp" srcset="/assets/img/lion-tongs.webp"><img src="/assets/img/lion-tongs.png" alt="The Do Si lion holding tongs and a slice of pork belly" width="420" height="393" loading="lazy"></picture>
    <div>
      <p class="kr-label kr-label--left" lang="ko">처음이세요?</p>
      <h2 class="display h2">New to <span class="accent">Korean BBQ?</span></h2>
      <ol class="steps">
        <li><b>1</b><span>Pick Signature, Premium or Supreme for the table.</span></li>
        <li><b>2</b><span>Order up to 4 meats and 2 appetizers a round. Banchan comes with it.</span></li>
        <li><b>3</b><span>Your server gets the grill going and shows you how. Order again whenever you’re ready.</span></li>
      </ol>
      <blockquote class="pull"><p>“{{ R.firstTimers.quote }}”</p><cite>{{ R.firstTimers.name }}, Google review</cite></blockquote>
    </div>
  </div>
</section>

<section class="rail" aria-label="Photos from Do Si">
  <div class="rail__track">
    {% for n in [1, 2] %}
    {% for p in ["grill-spread", "alki-deck", "bibimbap-egg", "kbbq-feast", "dumplings-photo", "dining-room", "cocktails-pink", "kimchi-rice-spoon", "tofu-stew-photo", "bar", "fries-stew", "kbbq-spread-2", "cocktail-orange"] %}
    <div class="rail__item{% if p in ['bibimbap-egg', 'cocktails-pink', 'fries-stew', 'cocktail-orange'] %} rail__item--tall{% endif %}"{% if n == 2 %} aria-hidden="true"{% endif %}>{% img p, ("" if n == 2 else "Food and dining at Do Si Korean BBQ"), { sizes: "40vw" } %}</div>
    {% endfor %}
    {% endfor %}
  </div>
</section>

{# ================= HAPPY HOUR (Alki): the neon menu ================= #}
{% if HH %}
<section class="neon" id="happy-hour">
  <img class="neon__palm neon__palm--l" src="/assets/img/hh/palm-left.webp" alt="" width="320" height="330" loading="lazy" aria-hidden="true">
  <img class="neon__palm neon__palm--r" src="/assets/img/hh/palm-right.webp" alt="" width="290" height="330" loading="lazy" aria-hidden="true">
  <div class="wrap neon__inner">
    <p class="neon__kicker">Happy Hour · Alki Beach</p>
    <h2 class="neon__title">Grill &amp; Chill</h2>
    <p class="neon__hours">{{ HH.hours | replace("PM", "pm") | replace("-", " – ") | replace("CLOSE", "close") }}</p>

    {%- set bites = HH.sections[0] -%}
    <h3 class="neon__head">Bites</h3>
    <div class="hh-bites">
      {% for i in bites.items %}{% if i.photo %}
      <figure class="hh-bite">
        <img src="{{ i.photo }}" alt="{{ i.name | lower }}" width="320" height="320" loading="lazy" decoding="async">
        <figcaption><span>{{ i.name | lower }}</span><b>{{ i.price }}</b></figcaption>
      </figure>
      {% endif %}{% endfor %}
    </div>

    {%- set drinks = HH.sections[1] -%}
    {% if drinks %}
    <h3 class="neon__head">{{ drinks.name | lower }}</h3>
    <div class="hh-drinks">
      {% for i in drinks.items %}{% if i.photo %}
      <figure class="hh-drink">
        <img src="{{ i.photo }}" alt="{{ i.name | lower }}" width="320" height="213" loading="lazy" decoding="async">
        <figcaption><span>{{ i.name | lower }}</span><b>{{ i.price }}</b></figcaption>
      </figure>
      {% endif %}{% endfor %}
    </div>
    {% endif %}
    {%- set bw = HH.sections[2] -%}
    {% if bw %}<p class="hh-deals">{% for i in bw.items %}<span><b>{{ i.price | lower }}</b> {{ i.name | lower | replace("(excluding wells)", "(not wells)") }}</span>{% endfor %}</p>{% endif %}
    <a class="btn btn--neon" href="/alki-menu/#happy-hour">Full happy hour menu</a>
  </div>
</section>
{% endif %}

{# ================= REVIEWS ================= #}
<section class="section" id="reviews">
  <div class="wrap">
    <p class="kr-label" lang="ko">손님 후기</p>
    <h2 class="rule-head"><span class="accent">What Guests</span> Say</h2>
    <p class="sub"><b class="gold">{{ R.summary.rating }} ★</b> average from {{ R.summary.count }} Google reviews of our Alki location</p>
    <div class="quotes">
      {% for q in R.home %}
      <figure class="quote">
        <span class="stars" aria-label="5 out of 5 stars">★★★★★</span>
        <blockquote>“{{ q.quote }}”</blockquote>
        <figcaption>{{ q.name }}</figcaption>
      </figure>
      {% endfor %}
    </div>
    <p class="center"><a class="arrow-link" href="{{ alki.address | mapsUrl }}" target="_blank" rel="noopener">All reviews on Google</a></p>
  </div>
</section>

<section class="bleed bleed--dark">
  <div class="bleed__img">{% img "grill-spread", "A table of meats sizzling on the grill with banchan", { sizes: "100vw" } %}</div>
  <div class="wrap bleed__inner">
    <blockquote class="bleed__quote">“{{ R.room.quote }}”</blockquote>
    <p class="bleed__cite">{{ R.room.name }}, Google review</p>
  </div>
</section>

{# ================= LOCATIONS ================= #}
<section class="section" id="locations">
  <div class="wrap">
    <p class="kr-label" lang="ko">매장 안내</p>
    <h2 class="rule-head"><span class="accent">Two</span> Locations</h2>
    <div class="locs">
      {% for l in [alki, kent] %}
      <article class="loc">
        <div class="loc__img">{% img l.photo, l.fullName, { sizes: "(max-width: 880px) 100vw, 50vw" } %}</div>
        <div class="loc__body">
          <p class="loc__area">{{ l.neighborhood }}</p>
          <h3>{{ l.name }}</h3>
          <span class="status-line" data-hours='{{ l.hours | json }}'><span class="dot"></span><span data-status>Hours below</span></span>
          <div class="loc__meta">
            <div>
              <h4 class="loc__k">Hours</h4>
              <ul class="hours" data-hours='{{ l.hours | json }}'>{% for r in l.hours | hoursRows %}<li><span>{{ r.days }}</span><span>{{ r.time }}</span></li>{% endfor %}</ul>
            </div>
            <div>
              <h4 class="loc__k">Find us</h4>
              <p class="loc__addr"><a href="{{ l.address | mapsUrl }}" target="_blank" rel="noopener" data-apnosh="directions">{{ l.address.street }}<br>{{ l.address.city }}, {{ l.address.state }}</a><br><a href="{{ l.phone | telHref }}">{{ l.phone }}</a></p>
            </div>
          </div>
          <div class="btn-row loc__btns">
            <a class="btn btn--red" href="{{ l.reserveUrl }}" data-apnosh="book" target="_blank" rel="noopener">Reserve</a>
            {% if l.orderUrl %}<a class="btn btn--light" href="{{ l.orderUrl }}" target="_blank" rel="noopener">Order pickup</a>{% endif %}
          </div>
          <p class="loc__links"><a href="{{ l.menuPage }}">See the menu</a><a href="{{ l.address | mapsUrl }}" target="_blank" rel="noopener" data-apnosh="directions">Directions</a></p>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="bleed bleed--short bleed--dark">
  <div class="bleed__img">{% img "alki-deck-wide", "The Alki Beach rooftop deck with umbrellas and string lights over the water", { sizes: "100vw" } %}</div>
  <div class="wrap bleed__inner">
    <p class="kr-label kr-label--left" lang="ko">단체 예약</p>
    <h2 class="display h2"><span class="accent">Parties</span> &amp; Buyouts</h2>
    <p class="bleed__text">Book the private 2nd floor at Alki Beach for up to 40 guests, 7 days a week. Company dinners, birthdays, holiday parties.</p>
    <div class="btn-row"><a class="btn btn--red" href="/private-events/">Request a date</a><a class="btn btn--ghost" href="/locations/#reserve" data-reserve>Reserve a table</a></div>
  </div>
</section>

{% if apnosh.upcomingEvents and apnosh.upcomingEvents.length %}
<section class="section">
  <div class="wrap">
    <h2 class="rule-head"><span class="accent">Coming</span> Up</h2>
    <div class="events">
      {% for e in apnosh.upcomingEvents | batch(4) | first %}
      <article class="event"><p class="event__date">{{ e.start_at | niceDate }}</p><h3>{{ e.name }}</h3>{% if e.description %}<p class="muted">{{ e.description }}</p>{% endif %}</article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
