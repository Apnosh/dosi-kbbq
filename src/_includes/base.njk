{%- set pageTitle = (title + " | " + site.name) if title else (site.name + " | AYCE KBBQ on Alki Beach & in Kent, WA") -%}
{%- set pageDesc = description or site.description -%}
{%- set canonical = site.url + page.url -%}
{%- set ogImage = site.url + (ogImage or "/assets/img/og-image.jpg") -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ canonical }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="en_US">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ ogImage }}">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" href="/assets/icons/icon-32.png" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#0d0b0a">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Black+Han+Sans&family=Instrument+Serif:ital@1&family=Work+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap">
  <link rel="stylesheet" href="/assets/css/site.css?v={{ buildHash }}">
  {% block head %}{% endblock %}

  {% if apnosh.slug %}
  <!-- Apnosh tag: Google Analytics for the property connected in the portal, plus call / directions / reserve taps -->
  <script async src="{{ apnosh.portalBase }}/t/{{ apnosh.slug }}.js"></script>
  <script>window.DOSI_FORMS_ENDPOINT = {{ (apnosh.portalBase + '/api/forms/submit/' + apnosh.slug) | dump | safe }};</script>
  {% endif %}

  {% include "schema.njk" %}
</head>
<body class="{{ bodyClass or '' }}">
<a class="skip" href="#main">Skip to content</a>
{% include "nav.njk" %}

<main id="main">
{{ content | safe }}
</main>

{% include "footer.njk" %}
{% include "reserve-dialog.njk" %}

<nav class="actionbar" aria-label="Quick actions">
  <a class="actionbar__menu" href="/menu/">Menus</a>
  <a class="btn btn--red" href="/locations/#reserve" data-reserve>Reserve a table</a>
</nav>

<script src="/assets/js/site.js?v={{ buildHash }}" defer></script>
<script src="/assets/js/forms.js?v={{ buildHash }}" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
