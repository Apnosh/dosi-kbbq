<footer class="footer">
  <div class="footer__cta">
    <p class="kr-bg" aria-hidden="true">도시</p>
    <h2 class="display">Hungry <span class="serif">yet?</span></h2>
    <p>Walk-ins welcome. Groups and weekends, book ahead.</p>
    <div class="btn-row">
      {% for loc in locations %}<a class="btn {% if loop.first %}btn--red{% else %}btn--light{% endif %}" href="{{ loc.reserveUrl }}" data-apnosh="book" target="_blank" rel="noopener">Reserve {{ loc.name }}</a>{% endfor %}
    </div>
  </div>
  <div class="footer__grid">
    <div class="footer__brand">
      <picture><source type="image/webp" srcset="/assets/img/logo.webp"><img src="/assets/img/logo.png" alt="Do Si Korean BBQ" width="640" height="233" loading="lazy"></picture>
      <p>All-you-can-eat Korean BBQ, grilled at your table. On the Alki Beach waterfront and in Kent, WA.</p>
      <div class="socials">
        <a href="{{ site.social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor"/></svg></a>
        <a href="{{ site.social.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.9v3h2.6V21h3z"/></svg></a>
        <a href="{{ site.social.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.6 3c.3 2.2 1.6 3.6 3.9 3.8v2.6c-1.4.1-2.6-.3-3.9-1.1v5.3c0 6.8-7.4 8.9-10.4 4-1.9-3.2-.7-8.7 5.5-8.9v2.8c-.5.1-1 .2-1.4.4-1.4.5-2.2 1.4-2 3 .4 3 5.9 3.9 5.4-2V3h2.9z"/></svg></a>
      </div>
    </div>
    {% for loc in locations %}{% set l = loc | withPortal(apnosh) %}
    <div class="footer__loc">
      <h3>{{ l.name }}</h3>
      <a href="{{ l.address | mapsUrl }}" target="_blank" rel="noopener">{{ l.address.street }}<br>{{ l.address.city }}, {{ l.address.state }} {{ l.address.zip }}</a>
      <a href="{{ l.phone | telHref }}">{{ l.phone }}</a>
      <ul class="hours-mini">{% for r in l.hours | hoursRows %}<li><span>{{ r.days }}</span><span>{{ r.time }}</span></li>{% endfor %}</ul>
    </div>
    {% endfor %}
    <div class="footer__links">
      <h3>Explore</h3>
      <a href="/alki-menu/">Alki Beach menu</a>
      <a href="/kent-menu/">Kent menu</a>
      <a href="/locations/">Locations</a>
      <a href="/private-events/">Private events at Alki</a>
      <a href="/about/">About</a>
      <a href="/faq/">FAQ</a>
      <a href="/contact/">Contact</a>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
  </div>
  <div class="footer__base">
    <span>© {{ year }} Do Si Korean BBQ</span>
    <span>Web design by <a href="https://apnosh.com" target="_blank" rel="noopener">Apnosh</a></span>
  </div>
</footer>
