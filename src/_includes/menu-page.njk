---
layout: base.njk
bodyClass: page-menu
---
{%- set loc = locations | byKey(locKey) -%}
{%- set l = loc | withPortal(apnosh) -%}
{%- set tabs = menus[locKey] -%}
<section class="page-head page-head--menu">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/menu/">Menus</a><span aria-hidden="true">/</span><span>{{ loc.name }}</span></nav>
    <div class="menu-head">
      <div>
        <p class="eyebrow">{{ loc.neighborhood }}</p>
        <h1 class="display h1">{{ loc.name }} <span class="serif">menu</span></h1>
      </div>
      <div class="menu-switch" role="navigation" aria-label="Choose a location">
        {% for o in locations %}<a href="{{ o.menuPage }}"{% if o.key == locKey %} aria-current="page"{% endif %}>{{ o.name }}</a>{% endfor %}
      </div>
    </div>
    <p class="lede">{{ intro }}</p>
    <p class="chips"><span class="chip">🌶 Spicy</span><span class="chip">🌱 Vegetarian</span><span class="chip"><span class="tag tag--best">Best seller</span></span></p>
  </div>
</section>

<nav class="menu-tabs" aria-label="Menu sections">
  <div class="menu-tabs__inner">
    {% for t in tabs %}<a href="#{{ t.id }}">{{ t.label }}</a>{% endfor %}
  </div>
</nav>

<div class="wrap">
  {% for t in tabs %}
  <section class="menu-block" id="{{ t.id }}" aria-labelledby="{{ t.id }}-h">
    {%- set banner = { "ayce": "premium-cuts", "combo-alacarte": "meat-platter", "apps-entrees": "yangnyeom-wings", "bento-lunch": "bibimbap", "drinks": "interior-neon", "happy-hour": "grill-table" }[t.id] -%}
    {% if banner %}<div class="menu-banner">{% img banner, "", { sizes: "(max-width: 1240px) 100vw, 1200px" } %}</div>{% endif %}
    <div class="menu-block__head">
      <div>
        <h2 class="rule-head rule-head--left{% if t.id == 'drinks' or t.id == 'happy-hour' %} rule-head--drinks{% endif %}" id="{{ t.id }}-h">{{ t.label }}</h2>
        {% if t.intro.length %}<div class="chips">{% for c in t.intro %}<span class="chip{% if loop.first %} chip--gold{% endif %}">{{ c | replace("All You Can Eat | ", "") }}</span>{% endfor %}</div>{% endif %}
      </div>
      {% if t.id == 'ayce' %}<a class="btn btn--red" href="{{ loc.reserveUrl }}" data-apnosh="book" target="_blank" rel="noopener">Reserve {{ loc.name }}</a>{% endif %}
    </div>

    {% for s in t.sections %}
    <div class="menu-section">
      <div class="menu-section__head">
        <h3>{{ s.name }}</h3>
        {% if s.korean %}<span class="kr">{{ s.korean }}</span>{% endif %}
        {% if s.price %}<span class="menu-section__price">{{ s.price }}{% if t.id == 'ayce' %}<small>/ person</small>{% endif %}</span>{% endif %}
      </div>
      {% if s.note %}<p class="menu-section__note">{{ s.note }}</p>{% endif %}
      {%- set pics = s.featured if site.menuPhotos != "none" else [] -%}
      <div class="msec{% if pics.length %} msec--pics{% endif %}">
        {% if pics.length %}
        <div class="msec__pics msec__pics--{{ pics.length }}">
          {% for f in pics %}
          <figure class="msec__pic">
            <img src="{{ f.photo }}" alt="{{ f.name | lower }}" width="320" height="320" loading="lazy" decoding="async">
            <figcaption>{% if f.number %}<b>{{ f.number }}.</b> {% endif %}{{ f.name | lower }}</figcaption>
          </figure>
          {% endfor %}
        </div>
        {% endif %}
        {%- set plain = true -%}{% for i in s.items %}{% if i.price or i.number %}{% set plain = false %}{% endif %}{% endfor %}
        <div class="items{% if plain %} items--plain{% endif %}">
          {% for i in s.items %}
          <div class="item">
            <span class="item__num">{{ (i.number or "") | replace(".", "") }}</span>
            <div class="item__name">{% if i.korean %}<span class="item__kr" lang="ko">{{ i.korean }}</span>{% endif %}{{ i.name }}{% for k in i.tagKeys %}{% if k == 'spicy' %} <span class="chili" title="Spicy">🌶</span>{% elif k == 'spicy2' %} <span class="chili" title="Extra spicy">🌶🌶</span>{% elif k == 'veg' %} <span class="chili" title="Vegetarian">🌱</span>{% endif %}{% endfor %}{% if 'best' in i.tagKeys %} <span class="tag tag--best">Best seller</span>{% endif %}{% if 'new' in i.tagKeys %} <span class="tag tag--new">New</span>{% endif %}</div>
            {% if i.priceLines %}<span class="item__price item__price--sizes">{% for p in i.priceLines %}<span>{{ p }}</span>{% endfor %}</span>{% elif i.price %}<span class="item__price">{{ i.price }}</span>{% endif %}
            {% if i.description %}<p class="item__desc">{{ i.description }}</p>{% endif %}
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endfor %}

    {% if t.fineprint.length %}<div class="fineprint">{% for f in t.fineprint %}<p>{{ f }}</p>{% endfor %}</div>{% endif %}
  </section>
  {% endfor %}

  <div class="fineprint" style="margin-top:56px">
    <p>Prices and items can change. For today’s menu, call {{ loc.name }} at <a href="{{ l.phone | telHref }}">{{ l.phone }}</a>. Looking for our other location? See the <a href="{{ (locations | byKey('kent' if locKey == 'alki' else 'alki')).menuPage }}">{{ (locations | byKey('kent' if locKey == 'alki' else 'alki')).name }} menu</a>.</p>
  </div>
</div>
<div style="height:clamp(64px,9vw,120px)"></div>

{# Menu structured data: sections and priced items, so Google can read the menu #}
{%- set mSections = [] -%}
{%- for t in tabs -%}{%- for s in t.sections -%}
  {%- set mItems = [] -%}
  {%- for i in s.items -%}
    {%- set mi = { "@type": "MenuItem", "name": i.name } -%}
    {%- if i.description -%}{%- set mi = { "@type": "MenuItem", "name": i.name, "description": i.description } -%}{%- endif -%}
    {%- set pm = (i.price or "") | replace("$", "") -%}
    {%- if r/^\d+(\.\d+)?$/.test(pm | trim) -%}
      {%- set _x = mItems.push({ "@type": "MenuItem", "name": mi.name, "description": mi.description, "offers": { "@type": "Offer", "price": pm | trim, "priceCurrency": "USD" } }) -%}
    {%- else -%}
      {%- set _x = mItems.push(mi) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set _y = mSections.push({ "@type": "MenuSection", "name": t.label + " – " + (s.name or ""), "hasMenuItem": mItems }) -%}
{%- endfor -%}{%- endfor -%}
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "Menu", "name": "Do Si Korean BBQ " + loc.name + " menu", "url": site.url + page.url, "inLanguage": "en", "hasMenuSection": mSections } | json | safe }}</script>
