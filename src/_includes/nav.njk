{%- set onMenu = page.url == '/menu/' or page.url == '/alki-menu/' or page.url == '/kent-menu/' -%}
<header class="nav" id="nav">
  <div class="nav__inner">
    <a class="nav__logo" href="/" aria-label="Do Si Korean BBQ home">
      <picture><source type="image/webp" srcset="/assets/img/logo.webp"><img src="/assets/img/logo.png" alt="Do Si Korean BBQ" width="640" height="233"></picture>
    </a>
    <nav class="nav__links" aria-label="Main">
      <div class="nav__drop">
        <a href="/menu/"{% if onMenu %} aria-current="page"{% endif %}>Menus</a>
        <div class="nav__dropmenu">
          <a href="/alki-menu/">Alki Beach menu</a>
          <a href="/kent-menu/">Kent menu</a>
        </div>
      </div>
      <a href="/locations/"{% if '/locations/' in page.url %} aria-current="page"{% endif %}>Locations</a>
      <a href="/private-events/"{% if page.url == '/private-events/' %} aria-current="page"{% endif %}>Private events</a>
      <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
      <a href="/faq/"{% if page.url == '/faq/' %} aria-current="page"{% endif %}>FAQ</a>
      <a href="/contact/"{% if page.url == '/contact/' %} aria-current="page"{% endif %}>Contact</a>
    </nav>
    <a class="btn btn--red nav__cta" href="/locations/#reserve" data-reserve>Reserve</a>
    <button class="nav__burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer"><span></span><span></span><span></span></button>
  </div>
</header>

{# Phone menu. It sits outside the header on purpose: the header's blur would trap a fixed panel inside its 72px bar. #}
<div class="drawer" id="drawer" hidden>
  <p class="drawer__label">Menus</p>
  <div class="drawer__menus">
    {% for loc in locations %}<a href="{{ loc.menuPage }}"><small>{{ loc.neighborhood | replace("Alki Beach, ", "") }}</small>{{ loc.name }}</a>{% endfor %}
  </div>
  <nav class="drawer__links" aria-label="Pages">
    <a href="/locations/">Locations &amp; hours</a>
    <a href="/#happy-hour">Happy hour</a>
    <a href="/private-events/">Private events</a>
    <a href="/about/">About</a>
    <a href="/faq/">FAQ</a>
    <a href="/contact/">Contact</a>
  </nav>
  <p class="drawer__label">Order pickup</p>
  <div class="drawer__calls drawer__calls--order">
    {% for loc in locations %}{% if loc.orderUrl %}<a class="btn btn--light" href="{{ loc.orderUrl }}" target="_blank" rel="noopener">{{ loc.name }}</a>{% endif %}{% endfor %}
  </div>
  <p class="loc__links drawer__phones">{% for loc in locations %}<a href="{{ loc.phone | telHref }}">Call {{ loc.name }}</a>{% endfor %}</p>
  <a class="btn btn--red" href="/locations/#reserve" data-reserve>Reserve a table</a>
</div>
