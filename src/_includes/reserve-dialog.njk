<dialog class="reserve" id="reserve-dialog" aria-labelledby="reserve-title">
  <form method="dialog"><button class="reserve__close" aria-label="Close">×</button></form>
  <p class="eyebrow">Reservations</p>
  <h2 class="display" id="reserve-title">Which Do Si?</h2>
  <div class="reserve__grid">
    {% for loc in locations %}
    <a class="reserve__opt" href="{{ loc.reserveUrl }}" target="_blank" rel="noopener">
      <span class="reserve__name">{{ loc.name }}</span>
      <span class="reserve__addr">{{ loc.address.street }}, {{ loc.address.city }}</span>
      <span class="reserve__go">Book a table →</span>
    </a>
    {% endfor %}
  </div>
  <p class="reserve__note">Prefer to call? Alki <a href="{{ (locations | byKey('alki')).phone | telHref }}">{{ (locations | byKey('alki')).phone }}</a> · Kent <a href="{{ (locations | byKey('kent')).phone | telHref }}">{{ (locations | byKey('kent')).phone }}</a></p>
</dialog>
